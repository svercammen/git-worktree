#compdef wt

# Zsh completion for the wt shell function (git-wt integration).
# Install: add the following to ~/.zshrc BEFORE compinit:
#   fpath=(~/bin/completions $fpath)

_wt_branches() {
  git worktree list --porcelain 2>/dev/null \
    | awk '/^branch / { gsub("refs/heads/", "", $2); print $2 }'
  echo -
}

# Branches of linked (non-main) worktrees — candidates for `remove`.
_wt_removable_branches() {
  git worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { wt++ }
    /^branch / && wt > 1 { gsub("refs/heads/", "", $2); print $2 }
  '
}

_wt_worktrees() {
  local -a branches
  branches=($(_wt_branches))
  # l:|=* r:|=* enables substring/fuzzy matching: "feat" matches "feature/my-branch"
  compadd -M 'l:|=* r:|=*' -a branches
}

# Complete a remove target: exclude the main worktree and any branches already
# listed earlier on the command line so tab-cycle doesn't re-suggest them.
_wt_remove_targets() {
  local -a branches already filtered
  branches=($(_wt_removable_branches))
  # Already-typed remove args (between the subcommand and the word at cursor)
  if (( CURRENT > 3 )); then
    already=("${(@)words[3,CURRENT-1]}")
  fi
  local b arg skip
  for b in "${branches[@]}"; do
    skip=0
    for arg in "${already[@]}"; do
      if [[ "$b" == "$arg" ]]; then
        skip=1
        break
      fi
    done
    (( skip )) || filtered+=("$b")
  done
  compadd -M 'l:|=* r:|=*' -a filtered
}

_wt_open_prs() {
  command -v gh >/dev/null 2>&1 || return
  local -a entries
  # gh tab-completion: number:title (truncated). Quiet on auth/network failure.
  entries=("${(@f)$(gh pr list --limit 30 --json number,title \
    --jq '.[] | "\(.number):\(.title | .[0:60])"' 2>/dev/null)}")
  (( ${#entries} )) && _describe 'open PRs' entries
}

_wt_my_open_jira() {
  [[ -n "$JIRA_BASE_URL" && -n "$JIRA_EMAIL" && -n "$JIRA_API_TOKEN" ]] || return
  command -v curl >/dev/null 2>&1 || return
  local -a entries
  # Narrow: assignee=me, not done, updated within 14d. Short timeout keeps tab snappy.
  local jql='assignee=currentUser() AND statusCategory!=Done AND updated>=-14d'
  local raw
  raw=$(curl -sS --max-time 3 -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" \
    --get "${JIRA_BASE_URL%/}/rest/api/3/search/jql" \
    --data-urlencode "jql=${jql}" \
    --data-urlencode 'fields=summary' \
    --data-urlencode 'maxResults=30' 2>/dev/null) || return
  command -v jq >/dev/null 2>&1 || return
  entries=("${(@f)$(printf '%s' "$raw" | jq -r '.issues[]? | "\(.key):\(.fields.summary | .[0:60])"' 2>/dev/null)}")
  (( ${#entries} )) && _describe 'my open Jira' entries
}

_wt() {
  local -a subcommands
  subcommands=(
    'create:create a new worktree'
    'from:create a worktree from a Jira ticket or PR'
    'remove:remove one or more worktrees'
    'switch:switch to a worktree by partial name'
    'list:list all worktrees'
    'shell-init:print shell integration code for .zshrc'
  )

  if (( CURRENT == 2 )); then
    _describe 'subcommand' subcommands
    _wt_worktrees
    return
  fi

  case ${words[2]} in
    switch)
      (( CURRENT == 3 )) && _wt_worktrees
      ;;
    remove)
      _wt_remove_targets
      ;;
    from)
      if (( CURRENT == 3 )); then
        local -a _wt_from_targets
        _wt_from_targets=('pr:GitHub PR (followed by number)')
        _describe 'from target' _wt_from_targets
        _wt_my_open_jira
      elif (( CURRENT == 4 )) && [[ "${words[3]}" == "pr" ]]; then
        _wt_open_prs
      fi
      ;;
  esac
}

# fzf ** trigger: `wt switch **<Tab>` or `wt **<Tab>` opens an interactive fzf picker.
# Requires fzf shell integration (source ~/.fzf.zsh or equivalent).
_fzf_complete_wt() {
  _fzf_complete --prompt='worktree> ' --height 40% --reverse --border -- "$@" < <(
    _wt_branches
  )
}

_wt "$@"
